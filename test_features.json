                    "content": "<div style=\"font-family: sans-serif; padding: 20px; border: 1px solid #ccc;\">\n  <h2 style=\"color: #007acc;\">Invoice #{invoice_id:0000}</h2>\n  <p><strong>Billed To:</strong> {client_name:Client}</p>\n  <p><strong>Amount:</strong> <span style=\"font-weight:bold;\">${amount:0.00}</span></p>\n  <hr>\n  <p style=\"font-size: 0.8rem; color: #666;\">Payment due by {due_date:immediately}.</p>\n</div>",
                    "isRichText": true
                }
